Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:app|config|database|storage|tools)(?:/|$) - [F,L,NC]
    RewriteRule ^event/([a-z0-9-]+)/?$ event-details.php?slug=$1 [L,QSA,NC]
</IfModule>

<FilesMatch "^(bootstrap\.php)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
