Options -Indexes -ExecCGI

<FilesMatch "\.(?:php[0-9]?|phtml|phar|cgi|pl|py|jsp|asp|aspx|sh|bash|exe|com)$">
    Require all denied
</FilesMatch>

<IfModule mod_mime.c>
    RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
    RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar
</IfModule>
